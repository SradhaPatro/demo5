{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
